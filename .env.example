# Secrets for the Supabase edge functions. Never commit a filled-in copy.
# Set them with:  supabase secrets set --env-file .env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.)

# Anthropic API key for the workspace that pays for live AI.
ANTHROPIC_API_KEY=

# The only address allowed to use the control room.
ADMIN_EMAIL=

# A long random string that salts the class-code hash. Generate with:  openssl rand -hex 32
CLASS_CODE_PEPPER=

# Development only: also accept http://localhost and http://127.0.0.1 origins.
# AI_ALLOW_LOCALHOST=true
